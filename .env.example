# Copy to `.env.local` and fill in. Nothing here is read at build time except
# NEXT_PUBLIC_* values, which are inlined into the client bundle.

# --- Database (Vercel Postgres) ---
POSTGRES_URL=

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Membership note: signing in is not the same as being in the carpool. An
# account is only admitted once `publicMetadata.group` is set on it in the Clerk
# dashboard (any value, e.g. "members"); admins are admitted by their role.

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Web push (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Scheduled jobs ---
# Shared secret both cron routes require as `Authorization: Bearer <value>`.
# Unset means the routes refuse to run rather than defaulting to open.
CRON_SECRET=

# --- Traffic and departure alerts (TomTom) ---
TOMTOM_API_KEY=
HOME_ADDRESS=
WORK_ADDRESS=
# Minutes of slack between the "time to leave" push and actually needing to
# move. Optional; defaults to 10.
DEPARTURE_BUFFER_MINUTES=10

# --- Calendar feed ---
# Signs the per-person iCal subscribe URLs. Unset disables the feed entirely
# (the dashboard then hides the subscribe button). Rotating this invalidates
# every existing subscription URL, which is how a feed is revoked.
# Generate with: openssl rand -hex 32
CALENDAR_FEED_SECRET=

# --- Optional ---
# The zone the schedule's calendar days are expressed in. Defaults to
# America/Los_Angeles.
SCHEDULE_TIME_ZONE=America/Los_Angeles
